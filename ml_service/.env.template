# ============================================================
# ML Service — Environment Configuration Template
# Copy this to .env and fill in your values
# ============================================================

# --- SERVER ---
PORT=8000
DEBUG=False
# Comma-separated list of allowed frontend origins (no spaces)
ALLOWED_ORIGIN=http://localhost:8080

# Modern Groww Trading API (Recommended)
GROWW_API_KEY=your_api_key
GROWW_API_SECRET=your_api_secret
GROWW_TOTP_SECRET=your_32_digit_totp_seed

# Legacy / Unofficial Credentials (Optional)
GROWW_EMAIL=your_email@example.com
GROWW_PIN=1234
# Set to 'False' to enable real money trading.
# WARNING: Keep as 'True' until you are ready to trade real capital.
DRY_RUN=True

# --- STOCK UNIVERSE ---
# Comma-separated list of default stocks to pre-load at startup.
# Use .NS suffix for NSE (India) stocks. Leave blank to use built-in defaults.
# Default: RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS,ICICIBANK.NS
DEFAULT_STOCKS=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS,ICICIBANK.NS

# --- PORTFOLIO SETTINGS ---
# Initial portfolio balance (in INR for Indian stocks)
INITIAL_BALANCE=100000

# --- MODEL PATHS ---
MODEL_DIR=models/saved_models
CACHE_DIR=data/cache

# --- TRAINING CONFIG ---
LSTM_SEQUENCE_LENGTH=30
LSTM_HIDDEN_DIM=50
LSTM_NUM_LAYERS=2
LSTM_EPOCHS=20

PPO_LEARNING_RATE=0.0003
PPO_TOTAL_TIMESTEPS=500000

# --- NEWS API (for sentiment) ---
# Get a free key at https://newsapi.org
NEWS_API_KEY=your_news_api_key_here
